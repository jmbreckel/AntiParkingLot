  "description": "Antigravity Prompt Parking Lot plugin & Side-Pane MCP App UI for parking ideas, voice dictations, and screenshots while Antigravity works and sending them when ready.",
  "license": "MIT",
  "author": "jmbreckel",
  "homepage": "https://github.com/jmbreckel/AntiParkingLot#readme",
  "bugs": {
    "url": "https://github.com/jmbreckel/AntiParkingLot/issues"
  },
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "mcp",
    "mcp-app",
    "prompt-parking-lot",
    "productivity"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
